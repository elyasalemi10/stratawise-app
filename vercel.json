{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "syd1"
  ],
  "functions": {
    "src/app/(dashboard)/ocs/new/actions.ts": {
      "maxDuration": 300
    },
    "src/app/(dashboard)/ocs/[ocCode]/manage/document-actions.ts": {
      "maxDuration": 300
    },
    "src/app/(dashboard)/ocs/[ocCode]/manage/actions.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/ocr-sweep",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/gmail-sweep",
      "schedule": "*/5 * * * *"
    }
  ]
}
